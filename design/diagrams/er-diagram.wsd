@startuml voice_call_ai_er_diagram

skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle

title Voice-Call AI Assistant v1 — Entity Relationship Diagram (ERD)

entity "call_sessions" as call_sessions {
    + id : UUID [PK]
    --
    * caller_number : VARCHAR(16)
    * detected_language : VARCHAR(8)
    * session_status : VARCHAR(20)
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
}

entity "voice_reminders" as voice_reminders {
    + id : UUID [PK]
    --
    * caller_number : VARCHAR(16)
    * message_text : VARCHAR(500)
    * scheduled_for : TIMESTAMPTZ
    * category : VARCHAR(32)
    * status : VARCHAR(16)
    * attempt_count : INTEGER
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
}

entity "audit_logs" as audit_logs {
    + id : UUID [PK]
    --
    * action : VARCHAR(100)
    * entity_type : VARCHAR(50)
    * entity_id : UUID
    * changes : JSONB
    * request_id : VARCHAR(100)
    * created_at : TIMESTAMPTZ
}

legend bottom
  Storage Engine: PostgreSQL 16 with async SQLAlchemy ORM.
  All primary keys use UUIDv4 identifiers.
  Timestamps are stored in UTC format.
endlegend
@enduml